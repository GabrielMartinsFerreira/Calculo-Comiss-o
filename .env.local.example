# ── Supabase — públicas (expostas ao browser, prefixo obrigatório) ──
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui

# ── Supabase — SECRETA (nunca prefixar com NEXT_PUBLIC_, nunca expor ao cliente) ──
# Project Settings → API → service_role. Usada só em app/api/** (webhook/checkout).
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# ── Stripe — SECRETAS (apenas server-side) ──
STRIPE_SECRET_KEY=sk_test_ou_sk_live_aqui
STRIPE_PRICE_ID=price_do_plano_assinatura
STRIPE_WEBHOOK_SECRET=whsec_gerado_ao_criar_o_endpoint_no_dashboard_stripe

# ── URL pública do site (usada nos redirects de checkout/portal) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Rate limiting distribuído (OPCIONAL) ──
# Sem estas duas variáveis, o app usa um limiter em memória (funciona, mas
# não é exato entre instâncias serverless). Criar em upstash.com (grátis) →
# Redis database → REST API. Nenhuma mudança de código é necessária.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Anti-bot no login/cadastro (OPCIONAL) ──
# Sem esta variável, o widget não aparece (fica só o honeypot). Criar em
# dash.cloudflare.com → Turnstile (grátis) → copiar a Site Key aqui e a
# Secret Key em: Supabase Dashboard → Authentication → Settings →
# "Enable CAPTCHA protection" → provider Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
